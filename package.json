  "private": true,
  "description": "My Personal AI Brain",
  "scripts": {
    "test": "node --test tests/*.test.mjs functions/test/*.test.js",
    "test:browser": "node tests/card-web-research.browser.mjs && node tests/byod-firebase.test.mjs",
